# =============================================================================
# StorageToken — Railway / local. Documented keys. Never commit real secrets.
# Default MODE=base_sepolia (84532). $STORE credits are the only storage payment.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
# paper | base_sepolia | base_mainnet_guarded | full_live
MODE=base_sepolia

# live senders: base_dedicated | uniswap_hitch | coinbase_onchain
# paper/stub avenues (disabled as senders): wave_first | gap_fill | priority_express | multi_chain_cheapest
# stubs (disabled): x402 | kite
ENTRY_POINT=base_dedicated

PORT=3001
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# --- Base Sepolia (live test, chainId 84532) --------------------------------
# Public RPC is fine for tonight. Swap for Alchemy/Infura if rate-limited.
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Hot / risk key that SIGNS inject txs only. Fund with Sepolia ETH for gas.
# Vault never spends save — do not put the vault key here.
INJECTOR_PRIVATE_KEY=

# Optional: checksum of the vault (save) address. Service refuses if this
# equals the injector address.
VAULT_ADDRESS=

# Default calldata `to` when the request omits provider (usually the router
# after deploy, or any address that will hold the strand bytes).
DEFAULT_PROVIDER=

# --- Contracts (set after `pnpm deploy` on Sepolia) -------------------------
STORE_TOKEN_ADDRESS=
ROUTER_ADDRESS=

# --- JWT = strand READ access, NOT money ------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_EXPIRY_HOURS=24

# --- Base mainnet (gated). Leave empty unless MODE=base_mainnet_guarded
# or full_live. Default MODE=base_sepolia refuses 8453.
# POST /api/mode can flip in-memory for this process (requires confirmMainnet:"yes"
# + BASE_RPC). Railway env is the source of truth on restart — set these for a
# durable flip. See COINBASE_LIVE_SWITCH.md.
# BASE_RPC=
# CONFIRM_MAINNET=no

# --- Coinbase CDP / Base wallet (on-chain ONLY) -----------------------------
# CEX Advanced Trade CANNOT carry calldata. Do not set CEX keys here.
# coinbase_onchain stays disabled until apiKey + apiSecret + (walletSecret or projectId).
# Preferred names:
COINBASE_CDP_API_KEY=
COINBASE_CDP_API_SECRET=
COINBASE_CDP_WALLET_SECRET=
COINBASE_CDP_PROJECT_ID=
# Optional stable EVM address when the wallet secret is not a hex key:
# COINBASE_CDP_ADDRESS=
#
# Guardian-protocol-agent names (used if the COINBASE_CDP_* name is unset):
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=
#
# Aliases from the old coinbase-multi-injector guide (used if the CDP name is unset):
# COINBASE_API_KEY=          → COINBASE_CDP_API_KEY
# COINBASE_API_SECRET=       → COINBASE_CDP_API_SECRET
# COINBASE_PRIVATE_KEY=      → COINBASE_CDP_WALLET_SECRET
#
# CDP requestFaucet is Sepolia-only. Fund fundAddress with Base ETH for mainnet.

# --- Telegram alerts (optional) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Future stubs (stay disabled even if true) ------------------------------
X402_ENABLED=false
KITE_ENABLED=false

# --- Deploy-only (scripts/deploy.ts) ----------------------------------------
# EMISSION_SINK=
# SEED_CREDITS_TO=
# SEED_CREDITS_AMOUNT=1000000000000000000000
